{
  "name": "duobalance-qa-automation",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium",
    "test:api": "playwright test --project=api",
    "test:api:local": "node --import tsx tests/helpers/runLocalApiTests.ts",
    "test:api:local:direct": "playwright test --config playwright.api-local.config.ts",
    "test:e2e:local": "playwright test --config playwright.api-e2e.config.ts",
    "test:list": "playwright test --list",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report playwright-report/published",
    "report:api:local": "playwright show-report playwright-report/local-api",
    "report:e2e:local": "playwright show-report playwright-report/local-api-e2e"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roaragonesc/duobalance-qa-automation.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/roaragonesc/duobalance-qa-automation/issues"
  },
  "homepage": "https://github.com/roaragonesc/duobalance-qa-automation#readme",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "mongodb-memory-server": "^10.2.0",
    "mongoose": "^8.19.0",
    "tsx": "^4.20.0",
    "typescript": "~7.0.2"
  }
}
